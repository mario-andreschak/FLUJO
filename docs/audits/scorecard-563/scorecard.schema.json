          "pilot-users": {
            "operator": ">=",
            "limit": 10,
            "unit": "humans",
            "observation": {
              "clock": "elapsed",
              "minimumSeconds": 4838400,
              "minimumSimulatedDays": 0,
              "minimumDenominator": 10
