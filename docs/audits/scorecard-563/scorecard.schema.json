{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flujo.com.co/schemas/scorecard-563.v1.json",
  "title": "FLUJO epic 563 contract and evidence ledger",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "epic",
    "scope",
    "owners",
    "profiles",
    "rubric",
    "budgets",
    "agreements",
    "artifacts",
    "evidence",
    "gates",
    "claims",
    "issueReconciliation",
    "assessment"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "epic": {
      "const": 563
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "originalAuditSha",
        "sourceBaselineSha",
        "sourcePackageVersion",
        "baselineDate",
        "objective",
        "profileReduction"
      ],
      "properties": {
        "originalAuditSha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "sourceBaselineSha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "sourcePackageVersion": {
          "type": "string",
          "minLength": 1
        },
        "baselineDate": {
          "type": "string",
          "minLength": 1
        },
        "objective": {
          "const": "All nine original dimensions independently reassessed at A- or better"
        },
        "profileReduction": {
          "const": "none"
        }
      }
    },
    "owners": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/owner"
      },
      "minItems": 9
    },
    "profiles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/profile"
      },
      "minItems": 3
    },
    "rubric": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/row"
      },
      "minItems": 9
    },
    "budgets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/budget"
      },
      "minItems": 1
    },
    "agreements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maintainer",
        "independentReviewer",
        "disagreements"
      ],
      "properties": {
        "maintainer": {
          "$ref": "#/$defs/agreement"
        },
        "independentReviewer": {
          "$ref": "#/$defs/agreement"
        },
        "disagreements": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifact"
      },
      "minItems": 1
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      },
      "minItems": 1
    },
    "gates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/gate"
      },
      "minItems": 1
    },
    "claims": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claim"
      },
      "minItems": 9
    },
    "issueReconciliation": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/issue"
      },
      "minItems": 11
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "sourceSha",
        "reviewer",
        "independent",
        "artifactIds",
        "evidenceIds",
        "grades",
        "acceptedExperimentalClaimIds"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "completed"
          ]
        },
        "sourceSha": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "reviewer": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "independent": {
          "type": "boolean"
        },
        "artifactIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "evidenceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "grades": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "dimensionId",
              "grade",
              "rationale"
            ],
            "properties": {
              "dimensionId": {
                "type": "string",
                "minLength": 1
              },
              "grade": {
                "type": "string",
                "enum": [
                  "A+",
                  "A",
                  "A-",
                  "B+",
                  "B",
                  "B-",
                  "C+",
                  "C",
                  "C-",
                  "D",
                  "F"
                ]
              },
              "rationale": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "minItems": 0
        },
        "acceptedExperimentalClaimIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        }
      }
    }
  },
  "$defs": {
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "role",
        "humanName",
        "acceptance"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "humanName": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "acceptance": {
          "type": "string",
          "enum": [
            "unassigned",
            "accepted"
          ]
        }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "status",
        "trustBoundaries",
        "osInstallMatrix",
        "prerequisites",
        "exclusions",
        "gateIds"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "current-local-envelope",
            "gated-proposal",
            "accepted"
          ]
        },
        "trustBoundaries": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "osInstallMatrix": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "platform",
              "methods",
              "acceptance"
            ],
            "properties": {
              "platform": {
                "type": "string",
                "minLength": 1
              },
              "methods": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              },
              "acceptance": {
                "type": "string",
                "enum": [
                  "documented-unverified",
                  "pending",
                  "verified"
                ]
              }
            }
          },
          "minItems": 1
        },
        "prerequisites": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "exclusions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "gateIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "dimension",
        "originalGrade",
        "targetGrade",
        "ownerId",
        "baseline",
        "criteria",
        "evidenceRequired",
        "issues"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "dimension": {
          "type": "string",
          "minLength": 1
        },
        "originalGrade": {
          "type": "string",
          "minLength": 1
        },
        "targetGrade": {
          "const": "A-"
        },
        "ownerId": {
          "type": "string",
          "minLength": 1
        },
        "baseline": {
          "type": "string",
          "minLength": 1
        },
        "criteria": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "evidenceRequired": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "baseline-observation",
              "source-check",
              "offline-simulation",
              "installed-artifact",
              "human-study",
              "live-provider",
              "security-review",
              "independent-assessment",
              "external-agreement"
            ]
          },
          "minItems": 1
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "minItems": 1
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "ownerId",
        "status",
        "metric",
        "operator",
        "limit",
        "unit",
        "denominator",
        "window",
        "basis",
        "declaredAt",
        "agreementEvidenceIds",
        "observation"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "ownerId": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "existing-contract",
            "proposed",
            "agreed"
          ]
        },
        "metric": {
          "type": "string",
          "minLength": 1
        },
        "operator": {
          "type": "string",
          "enum": [
            "<",
            "<=",
            ">=",
            ">",
            "="
          ]
        },
        "limit": {
          "type": "number",
          "minimum": 0
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "denominator": {
          "type": "string",
          "minLength": 1
        },
        "window": {
          "type": "string",
          "minLength": 1
        },
        "basis": {
          "type": "string",
          "minLength": 1
        },
        "declaredAt": {
          "type": "string",
          "minLength": 1
        },
        "agreementEvidenceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "observation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "clock",
            "minimumSeconds",
            "minimumSimulatedDays",
            "minimumDenominator"
          ],
          "properties": {
            "clock": {
              "type": "string",
              "enum": [
                "elapsed",
                "simulated",
                "any"
              ]
            },
            "minimumSeconds": {
              "type": "integer",
              "minimum": 0
            },
            "minimumSimulatedDays": {
              "type": "integer",
              "minimum": 0
            },
            "minimumDenominator": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "agreement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "identity",
        "evidenceIds"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "agreed",
            "disagreed"
          ]
        },
        "identity": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "evidenceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "identity",
        "sourceSha",
        "provenance",
        "payloadSha256",
        "metadataEvidenceIds"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "source",
            "npm",
            "container",
            "windows-installer"
          ]
        },
        "identity": {
          "type": "string",
          "minLength": 1
        },
        "sourceSha": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "provenance": {
          "type": "string",
          "enum": [
            "observed-metadata",
            "verified-content",
            "not-observed"
          ]
        },
        "payloadSha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "metadataEvidenceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "result",
        "integrity",
        "sourceSha",
        "artifactId",
        "ownerId",
        "observedAt",
        "environment",
        "commands",
        "raw",
        "scope",
        "limits",
        "budgetIds",
        "metrics",
        "window",
        "links",
        "profileIds"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "baseline-observation",
            "source-check",
            "offline-simulation",
            "installed-artifact",
            "human-study",
            "live-provider",
            "security-review",
            "independent-assessment",
            "external-agreement"
          ]
        },
        "result": {
          "type": "string",
          "enum": [
            "passed",
            "failed",
            "pending",
            "not-evaluated"
          ]
        },
        "integrity": {
          "type": "string",
          "enum": [
            "checksummed",
            "reported-only"
          ]
        },
        "sourceSha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "artifactId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "ownerId": {
          "type": "string",
          "minLength": 1
        },
        "observedAt": {
          "type": "string",
          "minLength": 1
        },
        "environment": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "platform",
            "node",
            "provider",
            "tools"
          ],
          "properties": {
            "platform": {
              "type": "string",
              "minLength": 1
            },
            "node": {
              "type": "string",
              "minLength": 1
            },
            "provider": {
              "type": "string",
              "minLength": 1
            },
            "tools": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "commands": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "raw": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "location",
              "sha256",
              "verification"
            ],
            "properties": {
              "location": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "verification": {
                "type": "string",
                "enum": [
                  "local",
                  "metadata-only",
                  "not-verified"
                ]
              }
            }
          },
          "minItems": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "limits": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "budgetIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "metrics": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "budgetId",
              "value",
              "denominator",
              "numerator"
            ],
            "properties": {
              "budgetId": {
                "type": "string",
                "minLength": 1
              },
              "value": {
                "type": "number"
              },
              "denominator": {
                "type": "number",
                "minimum": 1
              },
              "numerator": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          },
          "minItems": 0
        },
        "window": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "start",
            "end",
            "simulatedDays"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "instant",
                "simulated",
                "elapsed"
              ]
            },
            "start": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "end": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "simulatedDays": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 1
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "links": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "profileIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "ownerId",
        "kind",
        "profileIds",
        "status",
        "description",
        "evidenceIds"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "ownerId": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "source",
            "installed",
            "human",
            "live",
            "independent",
            "external"
          ]
        },
        "profileIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "passed",
            "failed"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "evidenceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "dimensionId",
        "profileId",
        "statement",
        "status",
        "requiredKinds",
        "evidenceIds",
        "budgetIds",
        "gateIds"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "dimensionId": {
          "type": "string",
          "minLength": 1
        },
        "profileId": {
          "type": "string",
          "minLength": 1
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "source-supported",
            "release-supported",
            "experimental"
          ]
        },
        "requiredKinds": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "baseline-observation",
              "source-check",
              "offline-simulation",
              "installed-artifact",
              "human-study",
              "live-provider",
              "security-review",
              "independent-assessment",
              "external-agreement"
            ]
          },
          "minItems": 1
        },
        "evidenceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "budgetIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "gateIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issue",
        "state",
        "asOf",
        "sourceStatus",
        "releaseStatus",
        "interpretation",
        "remaining",
        "evidenceIds"
      ],
      "properties": {
        "issue": {
          "type": "integer",
          "minimum": 1
        },
        "state": {
          "type": "string",
          "enum": [
            "OPEN",
            "CLOSED"
          ]
        },
        "asOf": {
          "type": "string",
          "minLength": 1
        },
        "sourceStatus": {
          "type": "string",
          "enum": [
            "current-fix-present",
            "local-unintegrated",
            "design-open",
            "reported-automated-pass",
            "manual-open",
            "source-proposal"
          ]
        },
        "releaseStatus": {
          "type": "string",
          "enum": [
            "unverified",
            "reported-specific-release"
          ]
