# Keep the build context small and never bake user data or a local build into
# the image. Excluding .git also (harmlessly) reinforces the container update
# mode: even without FLUJO_CONTAINER, there'd be no git clone to self-update.
node_modules
.next
.next-*
.git
.github

# Legacy checkout user data — must never enter the image. The repository's
# mcp-servers/ directory is package source and must remain in the build context;
# container user data is mounted separately below /app/data.
db
workspaces
data
userdata
snapshots
screenshots
recordings
browser-profile
bash-utils
artifacts
test-outputs
.codex
**/node_modules
**/.cache

# Site assets are excluded except the public OAuth metadata imported by the app.
docs/images
githubpages/*
!githubpages/oauth
githubpages/oauth/*
!githubpages/oauth/client-metadata.json

# Local/scratch artifacts.
.tmp
*.tsbuildinfo
*.log
npm-debug.log*
.env
.env.*
Dockerfile
.dockerignore
docker-compose.yml
