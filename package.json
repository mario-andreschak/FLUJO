{
  "name": "flujo-ai",
  "version": "3.48.3",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://flujo.com.co/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mario-andreschak/FLUJO.git"
  },
  "bugs": {
    "url": "https://github.com/mario-andreschak/FLUJO/issues"
  },
  "engines": {
    "node": "^22.23.4 || ^24.22.1"
  },
  "workspaces": [
    "mcp-servers/bash",
    "mcp-servers/browser",
    "mcp-servers/filesystem",
    "mcp-servers/flujo",
    "mcp-servers/shared"
  ],
  "bin": {
    "flujo": "bin/flujo.mjs"
  },
  "files": [
    "LICENSE",
    ".next/**/*",
    "!.next/cache/**",
    "!.next/dev/**",
    "!.next/trace",
    "public/**/*",
    "scripts/launch-next.mjs",
    "scripts/canonical-data-root.mjs",
    "scripts/bootstrap-directory.mjs",
    "scripts/local-instance.mjs",
    "scripts/healthcheck.mjs",
    "scripts/operations-inspect.mjs",
    "scripts/subscription-allowance.mjs",
    "scripts/owner-bootstrap.mjs",
    "scripts/exclude-workspaces-from-next-glob.cjs",
    "scripts/exposure-mode.mjs",
    "scripts/migration-landscape-demo.mjs",
    "scripts/local-test-dependencies.cjs",
    "scripts/run-local-jest.cjs",
    "bin/**/*",
    "mcp-servers/README.md",
    "mcp-servers/*/dist/**/*",
    "mcp-servers/*/package.json",
    "mcp-servers/*/LICENSE",
    "mcp-servers/browser/scripts/install-browser.mjs",
    "next.config.mjs",
    "packages/avatar-sdk/**"
  ],
  "scripts": {
    "dev": "node scripts/launch-next.mjs dev --webpack",
    "turbo": "node scripts/launch-next.mjs dev --turbopack",
    "build": "npm run build:mcp && node --require ./scripts/exclude-workspaces-from-next-glob.cjs node_modules/next/dist/bin/next build --webpack",
    "dockerbuild": "gh workflow run publish-image.yml -R mario-andreschak/FLUJO --ref main",
    "build:mcp": "npm run build -w @flujo-ai/mcp-shared && npm run build -w @mario.andreschak/mcp-filesystem && npm run build -w @mario.andreschak/mcp-bash && npm run build -w @mario.andreschak/mcp-browser && npm run build -w @mario.andreschak/mcp-flujo",
    "typecheck": "next typegen && tsc --noEmit -p tsconfig.json",
    "verify:avatar-sdk": "node scripts/verify-avatar-sdk.mjs",
    "typecheck:mcp": "npm run typecheck --workspaces --if-present",
    "test:mcp": "node scripts/run-local-jest.cjs --selectProjects node --runInBand __tests__/mcp",
    "test:mcp-process-boundary": "node scripts/run-local-jest.cjs --selectProjects node --runInBand __tests__/mcp/processBoundary.test.ts __tests__/mcp/stdioServers.test.ts",
    "test:persona-process-boundary": "node scripts/run-local-jest.cjs --selectProjects node --runInBand __tests__/enduringAgents/personaProcessBoundary.test.ts",
    "test:persona-browser-fixture": "node --test scripts/persona-browser-acceptance/fixture-server.test.mjs",
    "test:persona-browser-environment": "node --test scripts/persona-browser-acceptance/environment.test.mjs",
    "test:persona-browser": "playwright test --config=playwright.personas.config.mjs",
    "test:persona-goal-endurance-evidence": "node --test scripts/persona-acceptance-source.test.mjs scripts/persona-goal-acceptance/endurance-data-root.test.cjs scripts/persona-goal-acceptance/endurance-evidence.test.mjs scripts/persona-goal-acceptance/model-turn-archive.test.mjs scripts/persona-goal-acceptance/runtime-provenance.test.mjs scripts/persona-goal-acceptance/public-fixture-server.test.mjs",
    "validate:persona-goal-endurance": "node scripts/validate-persona-goal-endurance.mjs",
    "validate:mcp-release": "node scripts/validate-mcp-release.mjs",
    "smoke:mcp-artifacts": "node scripts/smoke-mcp-artifacts.mjs",
    "start": "node scripts/launch-next.mjs start",
    "demo:migration-ui": "node scripts/migration-landscape-demo.mjs",
    "check:parallel-mcp:no-oauth": "node scripts/check-parallel-mcp-no-oauth.mjs",
    "lint": "eslint src",
    "lint:all": "eslint src __tests__ scripts --max-warnings=0",
    "test": "node scripts/run-local-jest.cjs",
    "test:memory-experiment": "node scripts/run-memory-experiment.cjs",
    "test:memory-recall-benchmark": "node scripts/run-memory-semantic-benchmark.cjs",
    "benchmark:memory-semantic": "node scripts/run-memory-semantic-benchmark.cjs",
    "test:ci": "node scripts/run-local-jest.cjs --ci --exclude-isolated-suites --exclude-enduring-agents --json --outputFile=jest-results.json",
    "test:isolated": "node scripts/run-local-jest.cjs --testSequencer=./scripts/isolated-test-sequencer.cjs --ci --selectProjects node --runInBand --json --outputFile=jest-results-isolated.json __tests__/mcp/internalServer.test.ts __tests__/mcp/protectedPackageRunner.test.ts __tests__/mcp/serverTasks.test.ts __tests__/scheduler/staticRealBashFlow.test.ts __tests__/flow/original520OfflineWorkload.test.ts __tests__/flow/nativeOriginalHost.test.ts __tests__/flow/firstDispatchConcurrency.test.ts __tests__/flow/archiveWriteQuarantineProcess.test.ts __tests__/model/claudeArchiveMemoryBoundary.test.ts __tests__/mcp/processBoundary.test.ts __tests__/mcp/stdioServers.test.ts __tests__/mcp/browserCaptureRecording.test.ts __tests__/packages/workspaceMcpTransfer.test.ts __tests__/snapshot/ShadowRepoService.test.ts __tests__/flow/modelHandlerArchiveMemory.test.ts __tests__/workspace/snapshotLargeFlow.test.ts",
    "verify:test-baseline": "node scripts/verify-test-baseline.cjs",
    "qualify:live-codex": "node scripts/qualify-live-codex.mjs",
    "test:watch": "node scripts/run-local-jest.cjs --watch",
    "test:dependencies": "node scripts/local-test-dependencies.cjs",
    "test:dependency-glob": "node --test scripts/next-lint-glob.test.mjs",
    "prepublishOnly": "npm run build && npm run validate:mcp-release",
    "version": "node scripts/sync-version.mjs && git add -u -- src README.md githubpages/index.html mcp-servers package.json package-lock.json",
    "release": "node scripts/release.mjs",
    "endurance:personas": "node scripts/run-persona-goal-endurance.mjs --mode=live --profile=structured-tools --duration-seconds=3600 --active-seconds=3540 --budget-usd=25 --confirm=controlled-effects",
    "soak:personas": "node scripts/run-persona-soak.mjs --days=28 --activities-per-day=20 --with-learning",
    "soak:personas:quick": "node scripts/run-persona-soak.mjs --quick --days=3 --activities-per-day=5 --with-learning",
    "test:enduring-agents": "node scripts/run-local-jest.cjs --testSequencer=./scripts/isolated-test-sequencer.cjs --ci --selectProjects node --runInBand --json --outputFile=jest-results-enduring-agents.json __tests__/enduringAgents/",
    "qualify:conversation-recovery": "node scripts/qualify-conversation-recovery.mjs"
  },
  "dependencies": {
    "@flujo-ai/avatar-sdk": "file:packages/avatar-sdk",
    "@anthropic-ai/claude-agent-sdk": "^0.3.306",
    "@anthropic-ai/sdk": "^0.135.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@google/genai": "^2.30.0",
    "@mario.andreschak/mcp-bash": "3.48.3",
    "@mario.andreschak/mcp-browser": "3.48.3",
    "@mario.andreschak/mcp-filesystem": "3.48.3",
    "@mario.andreschak/mcp-flujo": "3.48.3",
    "@modelcontextprotocol/client": "^2.3.1",
    "@modelcontextprotocol/core": "^2.3.1",
    "@modelcontextprotocol/ext-apps": "^2.0.3",
    "@modelcontextprotocol/ext-tasks": "0.2.2",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@modelcontextprotocol/server": "2.4.0",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "@openai/codex-sdk": "0.163.0",
    "@xyflow/react": "^12.12.0",
    "axios": "^1.20.0",
    "chokidar": "^6.0.0",
    "croner": "^10.0.1",
    "crypto-js": "^4.2.0",
    "jszip": "3.10.2",
    "lodash": "^4.18.1",
    "mcp-remote": "^0.15.2",
    "mcp-stdio-oauth": "^0.1.0",
    "next": "16.4.2",
    "node-fetch": "^3.3.2",
    "openai": "7.39.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-window": "^2.4.1",
    "remark-gfm": "^4.0.1",
    "simple-git": "^4.0.2",
    "slate": "^0.146.0",
    "slate-dom": "^0.147.0",
    "slate-history": "^0.144.0",
    "slate-react": "^0.147.1",
    "smol-toml": "1.9.1",
    "undici": "^8.12.3",
    "uuid": "^14.0.3",
    "yaml": "^2.9.1",
    "zod": "^4.6.7",
    "@openrouter/agent": "^0.11.0"
  },
  "overrides": {
    "fast-glob": "$fast-glob",
    "zod": "$zod",
    "postcss": "$postcss",
    "postcss-selector-parser": "7.1.6",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/crypto-js": "^4.2.2",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.17.26",
    "@types/node": "^22.20.5",
    "@types/picomatch": "^4.0.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19",
    "@typescript-eslint/parser": "8.72.0",
    "buffer": "^6.0.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.2",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "fast-glob": "file:tooling/next-lint-glob",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "node-loader": "^2.1.0",
    "picomatch": "4.0.7",
    "postcss": "^8.5.31",
    "postcss-flexbugs-fixes": "^5.0.2",
    "postcss-preset-env": "11.6.1",
    "process": "^0.11.10",
    "tinyglobby": "0.2.17",
    "typescript": "^6.0.3",
    "wait-on": "9.5.1",
    "webpack": "5.112.0"
  }
}
