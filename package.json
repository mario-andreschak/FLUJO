{
  "name": "flujo-ai",
  "version": "3.41.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "mcp-servers/bash",
    "mcp-servers/browser",
    "mcp-servers/filesystem",
    "mcp-servers/flujo",
    "mcp-servers/shared"
  ],
  "bin": {
    "flujo": "bin/flujo.mjs"
  },
  "files": [
    ".next/**/*",
    "!.next/cache/**",
    "public/**/*",
    "scripts/launch-next.mjs",
    "scripts/exposure-mode.mjs",
    "bin/**/*",
    "mcp-servers/README.md",
    "mcp-servers/*/dist/**/*",
    "mcp-servers/*/package.json",
    "next.config.mjs"
  ],
  "scripts": {
    "dev": "node scripts/launch-next.mjs dev --webpack -p 4200",
    "turbo": "node scripts/launch-next.mjs dev --turbopack -p 4200",
    "build": "npm run build:mcp && next build --webpack",
    "dockerbuild": "gh workflow run publish-image.yml -R mario-andreschak/FLUJO --ref main",
    "build:mcp": "npm run build -w @flujo-ai/mcp-shared && npm run build -w @mario.andreschak/mcp-filesystem && npm run build -w @mario.andreschak/mcp-bash && npm run build -w @mario.andreschak/mcp-browser && npm run build -w @mario.andreschak/mcp-flujo",
    "typecheck:mcp": "npm run typecheck --workspaces --if-present",
    "test:mcp": "npm run test --workspaces --if-present",
    "test:mcp-process-boundary": "jest --selectProjects node --runInBand __tests__/mcp/processBoundary.test.ts __tests__/mcp/stdioServers.test.ts",
    "validate:mcp-release": "node scripts/validate-mcp-release.mjs",
    "smoke:mcp-artifacts": "node scripts/smoke-mcp-artifacts.mjs",
    "start": "node scripts/launch-next.mjs start -p 4200",
    "check:parallel-mcp:no-oauth": "node scripts/check-parallel-mcp-no-oauth.mjs",
    "lint": "eslint src",
    "test": "jest",
    "test:watch": "jest --watch",
    "prepublishOnly": "npm run build && npm run validate:mcp-release",
    "version": "node scripts/sync-version.mjs && git add -A src README.md githubpages/index.html mcp-servers package.json package-lock.json",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.220",
    "@anthropic-ai/sdk": "^0.115.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@google/genai": "^2.15.0",
    "@isomorphic-git/lightning-fs": "^4.7.0",
    "@mario.andreschak/mcp-bash": "3.41.0",
    "@mario.andreschak/mcp-browser": "3.41.0",
    "@mario.andreschak/mcp-filesystem": "3.41.0",
    "@mario.andreschak/mcp-flujo": "3.41.0",
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@mui/icons-material": "^6.5.0",
    "@mui/material": "^6.5.0",
    "@openai/codex-sdk": "^0.146.0",
    "@uiw/react-md-editor": "^4.1.1",
    "@xyflow/react": "^12.11.2",
    "axios": "^1.19.0",
    "chokidar": "^5.0.0",
    "croner": "^10.0.1",
    "crypto-js": "^4.2.0",
    "isomorphic-git": "^1.40.0",
    "jszip": "^3.10.1",
    "lodash": "^4.18.1",
    "mcp-remote": "^0.1.38",
    "mcp-stdio-oauth": "^0.1.0",
    "next": "^16.2.12",
    "node-fetch": "^3.3.2",
    "openai": "^7.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "simple-git": "^3.36.0",
    "slate": "^0.126.0",
    "slate-history": "^0.113.1",
    "slate-react": "^0.126.0",
    "undici": "^7.29.0",
    "uuid": "^14.0.1",
    "zod": "^4.4.3"
  },
  "overrides": {
    "zod": "$zod",
    "postcss": "$postcss",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/crypto-js": "^4.2.2",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.17.25",
    "@types/micromatch": "^4.0.10",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19",
    "@typescript-eslint/parser": "^8.65.0",
    "buffer": "^6.0.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.12",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "node-loader": "^2.1.0",
    "postcss": "^8.5.25",
    "postcss-flexbugs-fixes": "^5.0.2",
    "postcss-preset-env": "^11.3.2",
    "process": "^0.11.10",
    "typescript": "^6.0.3",
    "wait-on": "^9.1.0",
    "webpack": "^5.109.2"
  }
}
