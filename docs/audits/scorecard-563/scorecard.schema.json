            "denominator": "All enrolled humans reported; ten independent target users each week, excluding author/bots",
            "window": "Eight consecutive elapsed weeks",
            "basis": "#563 published plan; #577 agreement pending"
          },
          "novice-success": {
            "operator": ">=",
            "limit": 8,
            "unit": "humans",
            "observation": {
              "clock": "elapsed",
              "minimumSeconds": 0,
              "minimumSimulatedDays": 0,
              "minimumDenominator": 10
