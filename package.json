{
  "name": "flujo-ai",
  "version": "3.38.0",
  "workspaces": [
    "mcp-servers/*"
  ],
  "bin": {
    "flujo": "bin/flujo.mjs"
  },
  "files": [
    ".next/**/*",
    "!.next/cache/**",
    "public/**/*",
    "scripts/launch-next.mjs",
    "bin/**/*",
    "mcp-servers/README.md",
    "mcp-servers/*/dist/**/*",
    "mcp-servers/*/package.json",
    "next.config.mjs"
  ],
  "scripts": {
    "dev": "node scripts/launch-next.mjs dev -p 4200",
    "turbo": "node scripts/launch-next.mjs dev --turbopack -p 4200",
    "build": "npm run build:mcp && next build",
    "build:mcp": "npm run build -w @flujo-ai/mcp-shared && npm run build -w @flujo-ai/mcp-filesystem && npm run build -w @flujo-ai/mcp-bash && npm run build -w @flujo-ai/mcp-flujo",
    "typecheck:mcp": "npm run typecheck --workspaces --if-present",
    "test:mcp": "npm run test --workspaces --if-present",
    "validate:mcp-release": "node scripts/validate-mcp-release.mjs",
    "start": "node scripts/launch-next.mjs start -p 4200",
    "check:parallel-mcp:no-oauth": "node scripts/check-parallel-mcp-no-oauth.mjs",
    "lint": "next lint",
    "test": "jest",
    "test:watch": "jest --watch",
    "prepublishOnly": "npm run build && npm run validate:mcp-release",
    "version": "node scripts/sync-version.mjs && git add -A src README.md githubpages/index.html mcp-servers package.json package-lock.json",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "@flujo-ai/mcp-bash": "3.38.0",
    "@flujo-ai/mcp-filesystem": "3.38.0",
    "@flujo-ai/mcp-flujo": "3.38.0",
    "@anthropic-ai/claude-agent-sdk": "^0.3.186",
    "@anthropic-ai/sdk": "^0.105.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@google/genai": "^2.9.0",
    "@isomorphic-git/lightning-fs": "^4.6.0",
    "@modelcontextprotocol/client": "2.0.0-beta.5",
    "@modelcontextprotocol/ext-apps": "^1.7.4",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@mui/icons-material": "^6.4.5",
    "@mui/material": "^6.4.5",
    "@openai/codex-sdk": "^0.145.0",
    "@uiw/react-md-editor": "^4.0.5",
    "@xyflow/react": "^12.4.4",
    "axios": "^1.8.4",
    "chokidar": "^4.0.3",
    "croner": "^10.0.1",
    "crypto-js": "^4.2.0",
    "fetch-to-node": "^2.1.0",
    "isomorphic-git": "^1.29.0",
    "jszip": "^3.10.1",
    "lodash": "^4.17.21",
    "mcp-remote": "^0.1.18",
    "next": "^15.5.20",
    "node-fetch": "^3.3.2",
    "openai": "^4.86.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "simple-git": "^3.36.0",
    "slate": "^0.112.0",
    "slate-history": "^0.110.3",
    "slate-react": "^0.112.1",
    "uuid": "^11.1.0",
    "zod": "^4.4.3"
  },
  "overrides": {
    "zod": "$zod"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/crypto-js": "^4.2.2",
    "@types/jest": "^29.5.14",
    "@types/lodash": "^4.17.16",
    "@types/node": "20.17.30",
    "@types/react": "19.1.0",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/parser": "^8.26.1",
    "buffer": "^6.0.3",
    "eslint": "^9",
    "eslint-config-next": "15.1.7",
    "eslint-import-resolver-typescript": "^3.8.4",
    "eslint-plugin-import": "^2.31.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "node-loader": "^2.1.0",
    "postcss": "^8",
    "postcss-flexbugs-fixes": "^5.0.2",
    "postcss-preset-env": "^10.1.5",
    "process": "^0.11.10",
    "typescript": "5.8.3",
    "wait-on": "^8.0.2",
    "webpack": "^5.98.0"
  }
}
