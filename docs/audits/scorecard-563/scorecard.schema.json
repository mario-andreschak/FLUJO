{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flujo.com.co/schemas/scorecard-563.v1.json",
  "title": "FLUJO epic 563 contract and evidence ledger",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "epic",
    "scope",
    "owners",
    "profiles",
    "rubric",
    "budgets",
    "agreements",
    "artifacts",
    "evidence",
    "gates",
    "claims",
    "issueReconciliation",
    "assessment"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "epic": {
      "const": 563
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "originalAuditSha",
        "sourceBaselineSha",
        "sourcePackageVersion",
        "baselineDate",
        "objective",
        "profileReduction"
      ],
      "properties": {
        "originalAuditSha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "sourceBaselineSha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "sourcePackageVersion": {
          "type": "string",
          "minLength": 1
        },
        "baselineDate": {
          "type": "string",
          "minLength": 1
        },
        "objective": {
          "const": "All nine original dimensions independently reassessed at A- or better"
        },
        "profileReduction": {
          "const": "none"
        }
      }
    },
    "owners": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/owner"
      },
      "minItems": 9
    },
    "profiles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/profile"
      },
      "minItems": 3
    },
    "rubric": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/row"
      },
      "minItems": 9
    },
    "budgets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/budget"
      },
      "minItems": 1
    },
    "agreements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maintainer",
        "independentReviewer",
        "disagreements"
      ],
      "properties": {
        "maintainer": {
          "$ref": "#/$defs/agreement"
        },
        "independentReviewer": {
          "$ref": "#/$defs/agreement"
        },
        "disagreements": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifact"
      },
      "minItems": 1
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      },
      "minItems": 1
    },
    "gates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/gate"
      },
      "minItems": 1
    },
    "claims": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claim"
      },
      "minItems": 9
    },
    "issueReconciliation": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/issue"
      },
      "minItems": 11
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "sourceSha",
        "reviewer",
        "independent",
        "artifactIds",
        "evidenceIds",
        "grades",
        "acceptedExperimentalClaimIds"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "completed"
          ]
        },
        "sourceSha": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "reviewer": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "independent": {
          "type": "boolean"
        },
        "artifactIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "evidenceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "grades": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "dimensionId",
              "grade",
              "rationale"
            ],
            "properties": {
              "dimensionId": {
                "type": "string",
                "minLength": 1
              },
              "grade": {
                "type": "string",
                "enum": [
                  "A+",
                  "A",
                  "A-",
                  "B+",
                  "B",
                  "B-",
                  "C+",
                  "C",
                  "C-",
                  "D",
                  "F"
                ]
              },
              "rationale": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "minItems": 0
        },
        "acceptedExperimentalClaimIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        }
      }
    }
  },
