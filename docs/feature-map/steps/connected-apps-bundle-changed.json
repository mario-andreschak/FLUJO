[
  { "do": "drop-file", "role": "heading", "name": "MCP servers", "file": "__tests__/mcp/fixtures/mcpb-signed/hello-changed-after-signing.mcpb" },
  { "do": "wait-for", "role": "dialog", "name": "Install an MCP bundle" },
  { "do": "expect-text", "text": "Signature not valid", "within": { "role": "dialog", "name": "Install an MCP bundle" } },
  { "do": "expect-text", "text": "The file was changed after it was signed. FLUJO will not install this bundle.", "within": { "role": "dialog", "name": "Install an MCP bundle" } },
  { "do": "expect-state", "role": "button", "name": "Install", "exact": true, "state": "disabled", "within": { "role": "dialog", "name": "Install an MCP bundle" } },
  { "do": "shot", "out": "connected-apps/bundle-changed.png" },
  { "do": "aria", "out": "connected-apps/bundle-changed.yml" },
  { "do": "click", "role": "button", "name": "Close", "exact": true, "within": { "role": "dialog", "name": "Install an MCP bundle" } }
]
