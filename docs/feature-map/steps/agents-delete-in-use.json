[
  { "do": "click", "role": "link", "name": "Open desk" },
  { "do": "wait-for", "role": "tab", "name": "Setup", "timeout": 120000 },
  { "do": "click", "role": "tab", "name": "Setup" },
  { "do": "click", "role": "button", "name": "Change Flow" },
  { "do": "click", "role": "button", "name": "Use this Flow", "within": { "role": "group", "name": "Research", "exact": true } },
  { "do": "expect-no-text", "text": "Choose a Flow" },
  { "do": "goto", "route": "/flows" },
  { "do": "click", "role": "button", "name": "Delete agent", "within": { "role": "article", "name": "Research", "exact": true } },
  { "do": "wait-for", "role": "dialog", "name": "Delete “Research”?" },
  { "do": "expect-text", "text": "This agent is still in use. Choose what happens in each place, then delete it.", "within": { "role": "dialog", "name": "Delete “Research”?" } },
  { "do": "wait-for", "role": "group", "name": "Jim: Persona, Core Flow" },
  { "do": "wait-for", "role": "group", "name": "Morning research: Automation that runs this agent" },
  { "do": "wait-for", "role": "group", "name": "Coordinator: Agent that calls this one in a step" },
  { "do": "expect-state", "role": "button", "name": "Delete agent", "state": "disabled", "within": { "role": "dialog", "name": "Delete “Research”?" } },
  { "do": "select", "label": "Switch to", "option": "Research v2", "exactOption": true, "within": { "role": "group", "name": "Jim: Persona, Core Flow" } },
  { "do": "select", "label": "Switch to", "option": "Turn the automation off", "within": { "role": "group", "name": "Morning research: Automation that runs this agent" } },
  { "do": "select", "label": "Switch to", "option": "Empty the step for now", "within": { "role": "group", "name": "Coordinator: Agent that calls this one in a step" } },
  { "do": "expect-state", "role": "button", "name": "Delete agent", "state": "enabled", "within": { "role": "dialog", "name": "Delete “Research”?" } },
  { "do": "shot", "out": "agents/delete-in-use.png" },
  { "do": "aria", "out": "agents/delete-in-use.yml" },
  { "do": "click", "role": "button", "name": "Delete agent", "within": { "role": "dialog", "name": "Delete “Research”?" } },
  { "do": "expect-text", "text": "Agent deleted." },
  { "do": "click", "role": "button", "name": "Delete agent", "within": { "role": "article", "name": "Research v2", "exact": true } },
  { "do": "wait-for", "role": "dialog", "name": "Delete “Research v2”?" },
  { "do": "wait-for", "role": "group", "name": "Jim: Persona, Core Flow" },
  { "do": "select", "label": "Switch to", "option": "Remove it and pause Jim", "within": { "role": "group", "name": "Jim: Persona, Core Flow" } },
  { "do": "expect-text", "text": "Jim will be paused. A paused Persona starts no new work until you give it a Core Flow and wake it up.", "within": { "role": "dialog", "name": "Delete “Research v2”?" } },
  { "do": "click", "role": "button", "name": "Delete agent", "within": { "role": "dialog", "name": "Delete “Research v2”?" } },
  { "do": "expect-text", "text": "Agent deleted. Now paused: Jim." }
]
