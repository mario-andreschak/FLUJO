{
  "name": "@mario.andreschak/mcp-filesystem",
  "version": "3.48.2",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mario-andreschak/FLUJO.git",
    "directory": "mcp-servers/filesystem"
  },
  "description": "FLUJO's standalone confined filesystem MCP server",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "flujo-mcp-filesystem": "dist/index.js"
  },
  "files": [
    "LICENSE",
    "dist/**/*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../embed-shared.mjs filesystem && node ../embed-runtime.mjs filesystem",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test"
  },
  "engines": {
    "node": "^22.23.4 || ^24.22.1"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1"
  },
  "devDependencies": {
    "@flujo-ai/mcp-shared": "0.1.0",
    "@types/node": "^22.20.5",
    "typescript": "^6.0.3"
  }
}
